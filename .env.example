# Leave empty to run the deterministic offline provider (no network, no cost).
# With a key set, capture/grader/coach use the Anthropic API with forced tool use.
ANTHROPIC_API_KEY=

# Small, fast model for extraction and grading (see plan §3).
AI_MODEL=claude-haiku-4-5

# Optional: raises the default 20 AI calls/day per user.
AI_DAILY_LIMIT=
# Base URL override (proxy / gateway).
ANTHROPIC_BASE_URL=

# Protects POST /api/cron/coach when invoked by an external scheduler.
CRON_SECRET=

# SQLite file location (relative to project root or absolute).
DB_FILE=data/recall.db
